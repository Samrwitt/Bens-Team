# Server-only secrets. Never prefix these with VITE_ or put them in browser code.
# Leave the key blank to enable source previews without generated answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Random server-only value; store the same value in Vault as attachment_processing_secret.
ATTACHMENT_PROCESSING_SECRET=

# Private operator-hosted Tesseract/Poppler service; never an LLM endpoint.
LOCAL_OCR_URL=https://YOUR_OCR_HOST/extract
LOCAL_OCR_SECRET=YOUR_RANDOM_OCR_SECRET
